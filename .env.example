# PostgreSQL kết nối Prisma
DATABASE_URL="postgresql://bepsv:bepsv@localhost:5433/bepsv?schema=public"

# HTTP
PORT=3000
DEFAULT_USER_ID="demo-user"

# Giới hạn kho công thức siêu tốc (phút)
QUICK_RECIPE_MAX_MINUTES=20

# Ngưỡng "chế độ dinh dưỡng lành mạnh" mặc định cho mỗi khẩu phần
HEALTHY_MAX_KCAL=600
HEALTHY_MIN_PROTEIN=15

# Ngưỡng điểm khớp tối thiểu của gợi ý từ tủ lạnh (0..1)
FRIDGE_MATCH_THRESHOLD=0.6

# Google OAuth (lấy tại https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# JWT
JWT_SECRET="doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien"
JWT_EXPIRES_IN="7d"

# Frontend nhận token sau khi đăng nhập Google
FRONTEND_URL="http://localhost:5173"
